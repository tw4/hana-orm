# Copy to .env and fill in. .env is ignored by git; never commit real values.
HANA_HOST=localhost
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
# Tenant database name when connecting through the SYSTEMDB port (optional)
HANA_DATABASE=
# Default schema for unqualified table names (optional)
HANA_SCHEMA=
HANA_ENCRYPT=false
HANA_SSL_VALIDATE_CERTIFICATE=true
