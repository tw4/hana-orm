{
  "name": "hana-orm",
  "version": "1.0.0-rc.2",
  "description": "Type-safe TypeScript ORM for SAP HANA and HANA Cloud: Prisma-like schema, generated client, SQL-like query builder, migrations and a data browser.",
  "license": "Apache-2.0",
  "author": "tw4 (https://github.com/tw4)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tw4/hana-orm.git"
  },
  "homepage": "https://tw4.github.io/hana-orm/",
  "bugs": {
    "url": "https://github.com/tw4/hana-orm/issues"
  },
  "keywords": [
    "sap",
    "sap-hana",
    "hana",
    "hana-cloud",
    "hana-express",
    "sap-btp",
    "orm",
    "typescript",
    "type-safe",
    "database",
    "sql",
    "query-builder",
    "migrations",
    "schema",
    "prisma",
    "prisma-alternative",
    "typeorm-alternative",
    "nodejs",
    "hdb",
    "@sap/hana-client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "hana-orm": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate/index.d.ts",
      "default": "./dist/migrate/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "node test/setup.ts && tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:integration": "node test/setup.ts && node --test \"test/integration/**/*.itest.ts\"",
    "ci:local": "bash scripts/ci-local.sh",
    "bench:hana": "node bench/hana/run.ts",
    "prepare": "npm run build",
    "pretest": "node test/setup.ts"
  },
  "peerDependencies": {
    "@sap/hana-client": ">=2.20.0",
    "decimal.js": ">=10.4.0"
  },
  "peerDependenciesMeta": {
    "@sap/hana-client": {
      "optional": true
    },
    "decimal.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sap/hana-client": "^2.30.32",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
